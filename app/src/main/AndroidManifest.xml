<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.niutie.padhelper"
    android:versionCode="30"
    android:versionName="2.7.0">

    <!-- targetSdk 35 的包可见性：不声明这一条，getPackageInfo("jp.gungho.pad")
         会永远抛 NameNotFoundException，设置界面就永远显示「未检测到游戏」。 -->
    <queries>
        <package android:name="jp.gungho.pad" />
    </queries>

    <application
        android:allowBackup="false"
        android:description="@string/xposed_description"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.PADHelper">

        <!-- 新版 libxposed 模块元数据（LSPosed 2.x 通过 META-INF/xposed/ 识别，不再依赖 xposedmodule） -->
        <meta-data
            android:name="xposedscope"
            android:resource="@xml/scope_list" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />

        <!-- 真正的界面。不再自己带 LAUNCHER 过滤器：
             桌面图标由下面的 LauncherAlias 提供，那个 alias 可以随时启用/停用。 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.PADHelper" />

        <!-- 桌面图标。默认启用；「显示模块图标」关掉时设为 disabled，
             桌面图标消失，但 MainActivity 本身仍可被显式启动。 -->
        <activity-alias
            android:name=".ui.LauncherAlias"
            android:targetActivity=".ui.MainActivity"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="@string/app_name"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 隐藏入口：不带 LAUNCHER，桌面看不到；但带 CATEGORY_INFO，
             LSPosed 管理器按 resolveActivity 找模块入口时会退化到它。
             这样「关掉桌面图标」之后仍能从管理器打开设置，不会把自己锁在外面。 -->
        <activity-alias
            android:name=".ui.InfoAlias"
            android:targetActivity=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
